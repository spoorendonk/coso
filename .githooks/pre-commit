#!/bin/bash
# Git pre-commit hook.
#
#   1. Auto-format and auto-fix lint on staged files, then re-stage
#   2. Run the tests for the languages that changed — hard block on failure

set -e

HOOK_DIR=$(dirname "$0")
# shellcheck source-path=SCRIPTDIR
# shellcheck source=resolve-tools.sh
. "$HOOK_DIR/resolve-tools.sh"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

[ -z "$STAGED_FILES" ] && exit 0

# Files that already had unstaged changes before the formatters ran. Re-staging
# one of these would `git add` its whole content and sweep in hunks the author
# deliberately left out of the commit — so they are formatted but not re-staged,
# and named at the end.
# shellcheck disable=SC2086
PARTIALLY_STAGED=$(git diff --name-only -- $STAGED_FILES 2>/dev/null || true)

CPP_FILES=$(echo "$STAGED_FILES" | grep -E '\.(cpp|cc|cxx|h|hpp|hxx)$' || true)
PY_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
SH_FILES=$(shell_files "$STAGED_FILES")

# clang-tidy parses a translation unit per argument, so headers are not passed
# directly — a header is not a TU, and HeaderFilterRegex covers it when a .cpp
# including it is analysed. But that only holds if such a .cpp is in the same
# commit: a header-only change (src/routing/resources/ is entirely header-only)
# would otherwise get no analysis at all, so map those headers to TUs that
# include them.
CPP_TU_FILES=$(echo "$STAGED_FILES" | grep -E '\.(cpp|cc|cxx)$' || true)
STAGED_HEADERS=$(echo "$STAGED_FILES" | grep -E '\.(h|hpp|hxx)$' || true)
if [ -n "$STAGED_HEADERS" ]; then
	CPP_TU_FILES=$(printf '%s\n%s\n' "$CPP_TU_FILES" "$(tus_including "$STAGED_HEADERS")" |
		grep -v '^$' | sort -u || true)
fi

# ============================================================
# Step 1: Auto-format and auto-fix
# ============================================================

if [ -n "$CPP_FILES" ]; then
	if [ -n "$CLANG_FORMAT" ]; then
		# shellcheck disable=SC2086
		$CLANG_FORMAT -i $CPP_FILES
	else
		echo "note: clang-format not found — C++ formatting skipped."
	fi
fi

if [ -n "$SH_FILES" ]; then
	if [ -n "$SHFMT" ]; then
		# shellcheck disable=SC2086
		$SHFMT -w $SH_FILES
	else
		echo "note: shfmt not found — shell formatting skipped."
	fi
fi

if [ -n "$PY_FILES" ]; then
	if [ -n "$RUFF" ]; then
		# shellcheck disable=SC2086
		$RUFF format --quiet $PY_FILES
		# shellcheck disable=SC2086
		$RUFF check --fix --quiet $PY_FILES 2>/dev/null || true
	else
		echo "note: ruff not found — Python formatting and lint fixes skipped."
	fi
fi

if [ -n "$CPP_TU_FILES" ]; then
	if [ -z "$CLANG_TIDY" ]; then
		echo "note: clang-tidy not found — C++ lint fixes skipped."
	elif [ -z "$COMPILE_DB" ]; then
		echo "note: no compile_commands.json — C++ lint fixes skipped."
	else
		for f in $CPP_TU_FILES; do
			[ -f "$f" ] || continue
			# Not built in this configuration — nothing to analyse, and saying so
			# beats a header-not-found wall. Checked against the database itself
			# rather than by matching clang's error text.
			if ! in_compile_db "$f"; then
				echo "note: $f is not in the compile database — not analysed."
				continue
			fi
			# shellcheck disable=SC2086
			$CLANG_TIDY $COMPILE_DB \
				--checks="-*,modernize-use-nullptr,modernize-use-override,modernize-use-using,readability-braces-around-statements" \
				--fix --quiet "$f" >/dev/null 2>&1 || true
		done
	fi
fi

# Re-stage what the formatters rewrote, except files that were already dirty
# before they ran — `git add` stages a whole file, so re-adding one of those
# would commit content the author withheld.
SKIPPED_RESTAGE=""
# shellcheck disable=SC2086
while read -r f; do
	[ -n "$f" ] || continue
	if printf '%s\n' "$PARTIALLY_STAGED" | grep -qxF "$f"; then
		SKIPPED_RESTAGE="${SKIPPED_RESTAGE} $f"
		continue
	fi
	git add "$f"
done < <(git diff --name-only -- $STAGED_FILES 2>/dev/null)

if [ -n "$SKIPPED_RESTAGE" ]; then
	echo ""
	echo "note: these files had unstaged changes, so formatting was NOT re-staged:"
	for f in $SKIPPED_RESTAGE; do echo "        $f"; done
	echo "      The commit keeps the content you staged. Stage the formatting"
	echo "      separately if you want it in this commit."
fi

# ============================================================
# Step 2: Tests (hard block)
# ============================================================

echo "=== Pre-commit: running tests ==="

TESTS_FAILED=0
TESTS_RAN=0

if [ -n "$CPP_FILES" ]; then
	if ! command -v ctest &>/dev/null; then
		echo "note: ctest not found — C++ tests skipped."
	elif [ ! -d "build" ]; then
		echo "note: no build/ directory — C++ tests skipped. Configure with 'cmake -B build'."
	else
		# Build first, incrementally. Without this ctest runs whatever binaries
		# happen to be in build/, so the gate reports on the previous state of
		# the tree rather than on the change being committed.
		echo "Building..."
		if ! cmake --build build -j"$(nproc 2>/dev/null || echo 4)"; then
			echo "FAILED: build failed."
			TESTS_FAILED=1
			TESTS_RAN=1
		else
			echo "Running C++ tests..."
			TESTS_RAN=1
			if ! ctest --test-dir build --output-on-failure -j"$(nproc 2>/dev/null || echo 4)"; then
				echo "FAILED: C++ tests failed."
				TESTS_FAILED=1
			fi
		fi
	fi
fi

if [ -n "$PY_FILES" ]; then
	PYTEST=$(resolve_tool pytest)
	if [ -z "$PYTEST" ]; then
		echo "note: pytest not found — Python tests skipped."
	else
		echo "Running Python tests..."
		TESTS_RAN=1
		rc=0
		$PYTEST --tb=short -q || rc=$?
		# rc=5 means nothing was collected, which is not a failure.
		if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then
			echo "FAILED: Python tests failed."
			TESTS_FAILED=1
		fi
	fi
fi

if [ "$TESTS_FAILED" -ne 0 ]; then
	echo ""
	echo "Commit blocked: tests failed. Fix tests before committing."
	exit 1
fi

if [ "$TESTS_RAN" -eq 0 ]; then
	echo "No tests ran."
else
	echo "Tests passed."
fi
exit 0
