#!/bin/bash
# Git commit-msg hook.
# Validates Conventional Commits format: type: description, subject max 72 chars.

MSG_FILE="$1"
MSG=$(head -1 "$MSG_FILE")

# Merge and revert commits are generated by git itself.
if echo "$MSG" | grep -qE '^(Merge|Revert) '; then
	exit 0
fi

# Autosquash markers are validated against the commit they will be folded into,
# so rejecting them here would block `git rebase --autosquash`.
if echo "$MSG" | grep -qE '^(fixup|squash)! '; then
	exit 0
fi

TYPES="feat|fix|refactor|test|docs|style|perf|chore|build|ci"
if ! echo "$MSG" | grep -qE "^($TYPES)(\(.+\))?: .+"; then
	echo "ERROR: Commit message does not follow Conventional Commits format."
	echo ""
	echo "  Expected: type: description"
	echo "  Optional: type(scope): description"
	echo ""
	echo "  Types: feat, fix, refactor, test, docs, style, perf, chore, build, ci"
	echo ""
	echo "  Examples:"
	echo "    feat: add branch-and-bound solver"
	echo "    fix(parser): handle empty input"
	echo "    refactor: extract constraint builder"
	echo "    test: add edge case for infeasible model"
	echo ""
	echo "  Your message: $MSG"
	exit 1
fi

if [ ${#MSG} -gt 72 ]; then
	echo "ERROR: Subject line is ${#MSG} chars (max 72)."
	echo "  $MSG"
	exit 1
fi

exit 0
