#!/bin/bash
# Git pre-push hook — the final gate before code is shared.
#
#   1. Clean build + test, using the commands fenced in CLAUDE.md → hard block
#   2. Lint, complexity and type checks → warn and continue

set -e

HOOK_DIR=$(dirname "$0")
# shellcheck source-path=SCRIPTDIR
# shellcheck source=resolve-tools.sh
. "$HOOK_DIR/resolve-tools.sh"

# Git feeds one line per ref on stdin, as
#   <local ref> <local sha> <remote ref> <remote sha>
# with an all-zero local sha for a deletion. A deletion has no content to gate,
# and building HEAD for it would be gating something unrelated to the ref going
# away. Read stdin only when it is not a terminal, so running this hook by hand
# does not block waiting for EOF. A push mixing a deletion with a real update
# still runs everything.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS=$(cat)
if [ -n "$PUSH_REFS" ] && ! echo "$PUSH_REFS" | grep -qvE '^[^ ]+ 0+ '; then
	echo "pre-push: deletion only — nothing to gate."
	exit 0
fi

# Fetch before probing for the branch: testing origin/main first means a
# checkout that has not yet fetched it silently falls through to "master", the
# fetch of that nonexistent branch is swallowed, and the diff base collapses to
# HEAD~1 — gating a five-commit push on its last commit alone.
git fetch origin main --quiet 2>/dev/null || git fetch origin master --quiet 2>/dev/null || true
MAIN_BRANCH="main"
git rev-parse --verify "origin/$MAIN_BRANCH" &>/dev/null || MAIN_BRANCH="master"
CHANGED_FILES=$(git diff --name-only "origin/$MAIN_BRANCH"...HEAD 2>/dev/null || git diff --name-only HEAD~1 2>/dev/null || true)

[ -z "$CHANGED_FILES" ] && exit 0

PY_FILES=$(echo "$CHANGED_FILES" | grep -E '\.py$' || true)
SH_FILES=$(shell_files "$CHANGED_FILES")

# clang-tidy parses a translation unit per argument, so headers are not passed
# directly. That only covers them if a .cpp including them is in the same push,
# so header-only changes are mapped to translation units that include them.
CPP_TU_FILES=$(echo "$CHANGED_FILES" | grep -E '\.(cpp|cc|cxx)$' || true)
CHANGED_HEADERS=$(echo "$CHANGED_FILES" | grep -E '\.(h|hpp|hxx)$' || true)
if [ -n "$CHANGED_HEADERS" ]; then
	CPP_TU_FILES=$(printf '%s\n%s\n' "$CPP_TU_FILES" "$(tus_including "$CHANGED_HEADERS")" |
		grep -v '^$' | sort -u || true)
fi

# Docs-only pushes skip build+test.
CODE_FILES=$(echo "$CHANGED_FILES" | grep -vE '^(LICENSE|CHANGELOG)' | grep -vE '\.(md|txt|rst)$' | grep -vE '^\.(gitignore|gitattributes)$' || true)

# CMakeLists.txt wears a prose extension and the .txt filter above swallows it,
# so every build-system change looked docs-only and pushed without a build —
# the one kind of change that can break configure for everyone else. Put those
# back rather than loosening the filter, which would let tests/data/*.txt in.
CODE_FILES=$(printf '%s\n%s\n' "$CODE_FILES" \
	"$(echo "$CHANGED_FILES" | grep -E '(^|/)CMakeLists\.txt$' || true)" |
	grep -v '^$' | sort -u || true)

# ============================================================
# Step 1: Clean build + test (hard block)
# ============================================================

# Pull a fenced block out of CLAUDE.md's "## Build & Test" section by tag.
# The sed range ends at the next "## " heading, so that section must stay
# followed by another level-2 heading — a level-1 heading does not close it.
extract_block() {
	local tag="$1"
	[ -f "CLAUDE.md" ] || return 0
	sed -n -e '/^## Build & Test/,/^## /{' \
		-e "/^\`\`\`${tag}$/,/^\`\`\`$/{ /^\`\`\`/d; p; }" \
		-e '}' CLAUDE.md
}

CLEAN_CMD=$(extract_block clean)
BUILD_CMD=$(extract_block build)
TEST_CMD=$(extract_block test)

# Validated before the docs-only branch, not inside it. CLAUDE.md is itself a
# .md file, so the one commit that can break these fences is exactly the one a
# docs-only skip would wave through — and the breakage would then surface as an
# unexplained block on someone else's next code push.
MISSING=""
if [ -z "$BUILD_CMD" ]; then MISSING="${MISSING} build"; fi
if [ -z "$TEST_CMD" ]; then MISSING="${MISSING} test"; fi
if [ -n "$MISSING" ]; then
	echo ""
	echo "Push blocked: CLAUDE.md's '## Build & Test' section is missing a fence for:${MISSING}"
	echo "Expected blocks opened with \`\`\`build and \`\`\`test inside that section,"
	echo "and the section must still be followed by another '## ' heading."
	exit 1
fi

if [ -z "$CODE_FILES" ]; then
	echo ""
	echo "=== Skipping build+test (docs-only; fences verified) ==="
else
	BUILD_FAILED=0

	# The clean step is opt-in. It gates the same code as an incremental build,
	# but discards build/ and recompiles every TU plus the fetched dependencies
	# on each push — minutes for a one-line change, and it deletes the very
	# directory pre-commit builds and tests in, so the next commit after a push
	# starts from an unbuilt tree. Set COSO_PREPUSH_CLEAN=1 for the full rebuild.
	if [ -n "$CLEAN_CMD" ] && [ "${COSO_PREPUSH_CLEAN:-0}" = "1" ]; then
		echo ""
		echo "=== Clean ==="
		set +e
		eval "$CLEAN_CMD"
		rc=$?
		set -e
		if [ "$rc" -ne 0 ]; then BUILD_FAILED=1; fi
	fi

	if [ "$BUILD_FAILED" -eq 0 ]; then
		echo ""
		echo "=== Build ==="
		set +e
		eval "$BUILD_CMD"
		rc=$?
		set -e
		if [ "$rc" -ne 0 ]; then BUILD_FAILED=1; fi
	fi

	if [ "$BUILD_FAILED" -eq 0 ]; then
		echo ""
		echo "=== Test ==="
		set +e
		eval "$TEST_CMD"
		rc=$?
		set -e
		if [ "$rc" -ne 0 ]; then BUILD_FAILED=1; fi
	fi

	if [ "$BUILD_FAILED" -ne 0 ]; then
		echo ""
		echo "Push blocked: build or tests failed."
		exit 1
	fi
fi

# ============================================================
# Step 2: Remaining issues (warn and continue)
# ============================================================

ISSUES=""

if [ -n "$CPP_TU_FILES" ] && [ -n "$CLANG_TIDY" ] && [ -n "$COMPILE_DB" ]; then
	echo ""
	echo "=== Running clang-tidy ==="
	TIDY_PARSED=0
	TIDY_BROKEN=""
	for f in $CPP_TU_FILES; do
		[ -f "$f" ] || continue
		# Not built in this configuration: nothing to analyse. Decided from the
		# database itself, so it cannot be confused with a parse failure.
		if ! in_compile_db "$f"; then
			echo "note: $f is not in the compile database — not analysed."
			continue
		fi
		# shellcheck disable=SC2086
		RESULT=$($CLANG_TIDY $COMPILE_DB --quiet "$f" 2>&1 || true)
		# A file that IS in the database but will not parse means the lint setup
		# is broken — a compiler/database mismatch, say. Reported loudly: a step
		# that can analyse nothing must never look like a clean tree.
		if echo "$RESULT" | grep -q 'clang-diagnostic-error'; then
			TIDY_BROKEN="${TIDY_BROKEN} $f"
			continue
		fi
		TIDY_PARSED=$((TIDY_PARSED + 1))
		if echo "$RESULT" | grep -qE '(warning|error):'; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
	if [ -n "$TIDY_BROKEN" ]; then
		echo ""
		echo "WARNING: clang-tidy could not parse these files, which ARE in the"
		echo "         compile database — the lint setup is broken, not the code:"
		for f in $TIDY_BROKEN; do echo "           $f"; done
		if [ "$TIDY_PARSED" -eq 0 ]; then
			echo "         Nothing was analysed at all. Do not read this as a pass."
		fi
		echo "         Common cause: compile_commands.json generated by a compiler"
		echo "         whose flags or headers this clang-tidy does not understand."
	fi
fi

if [ -n "$PY_FILES" ] && [ -n "$RUFF" ]; then
	for f in $PY_FILES; do
		[ -f "$f" ] || continue
		RESULT=$($RUFF check --select C901 --no-fix "$f" 2>&1 || true)
		if [ -n "$RESULT" ] && ! echo "$RESULT" | grep -q "^All checks passed"; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
fi

if [ -n "$SH_FILES" ] && [ -n "$SHELLCHECK" ]; then
	for f in $SH_FILES; do
		[ -f "$f" ] || continue
		# -x follows sourced files. Without it every script that sources another
		# reports SC1091 "not following", which is a fact about how shellcheck
		# was invoked rather than anything wrong with the script.
		RESULT=$($SHELLCHECK -x "$f" 2>&1 || true)
		if [ -n "$RESULT" ]; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
fi

if [ -n "$PY_FILES" ] && [ -n "$MYPY" ]; then
	# mypy stops at the first unreadable path, so a single deleted .py would
	# both fake a failure and mask real type errors in every surviving file.
	EXISTING_PY=""
	for f in $PY_FILES; do
		[ -f "$f" ] && EXISTING_PY="${EXISTING_PY} $f"
	done
	if [ -n "$EXISTING_PY" ]; then
		echo ""
		echo "=== Running mypy ==="
		# shellcheck disable=SC2086
		RESULT=$($MYPY --strict $EXISTING_PY 2>&1 || true)
		if echo "$RESULT" | grep -qE '(error):'; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		else
			echo "mypy: clean"
		fi
	fi
fi

if [ -n "$ISSUES" ]; then
	echo ""
	echo "═══════════════════════════════════════════"
	echo "  Issues found:"
	echo "═══════════════════════════════════════════"
	echo "$ISSUES"
	echo "═══════════════════════════════════════════"
	echo ""
	echo "Warning: pushing with known issues."
else
	echo ""
	echo "All checks passed."
fi

exit 0
