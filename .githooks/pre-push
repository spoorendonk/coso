#!/bin/bash
# Git pre-push hook — the final gate before code is shared.
#
#   1. Clean build + test, using the commands fenced in CLAUDE.md → hard block
#   2. Lint, complexity and type checks → warn and continue

set -e

HOOK_DIR=$(dirname "$0")
# shellcheck source=resolve-tools.sh
. "$HOOK_DIR/resolve-tools.sh"

# Git feeds one line per ref on stdin, as
#   <local ref> <local sha> <remote ref> <remote sha>
# with an all-zero local sha for a deletion. A deletion has no content to gate,
# and building HEAD for it would be gating something unrelated to the ref going
# away. Read stdin only when it is not a terminal, so running this hook by hand
# does not block waiting for EOF. A push mixing a deletion with a real update
# still runs everything.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS=$(cat)
if [ -n "$PUSH_REFS" ] && ! echo "$PUSH_REFS" | grep -qvE '^[^ ]+ 0+ '; then
	echo "pre-push: deletion only — nothing to gate."
	exit 0
fi

MAIN_BRANCH="main"
git rev-parse --verify "origin/$MAIN_BRANCH" &>/dev/null || MAIN_BRANCH="master"
git fetch origin "$MAIN_BRANCH" --quiet 2>/dev/null || true
CHANGED_FILES=$(git diff --name-only "origin/$MAIN_BRANCH"...HEAD 2>/dev/null || git diff --name-only HEAD~1 2>/dev/null || true)

[ -z "$CHANGED_FILES" ] && exit 0

CPP_FILES=$(echo "$CHANGED_FILES" | grep -E '\.(cpp|cc|cxx|h|hpp|hxx)$' || true)
PY_FILES=$(echo "$CHANGED_FILES" | grep -E '\.py$' || true)
SH_FILES=$(echo "$CHANGED_FILES" | grep -E '\.sh$' || true)

# Docs-only pushes skip build+test.
CODE_FILES=$(echo "$CHANGED_FILES" | grep -vE '^(LICENSE|CHANGELOG)' | grep -vE '\.(md|txt|rst)$' | grep -vE '^\.(gitignore|gitattributes)$' || true)

# ============================================================
# Step 1: Clean build + test (hard block)
# ============================================================

# Pull a fenced block out of CLAUDE.md's "## Build & Test" section by tag.
# The sed range ends at the next "## " heading, so that section must stay
# followed by another level-2 heading — a level-1 heading does not close it.
extract_block() {
	local tag="$1"
	[ -f "CLAUDE.md" ] || return 0
	sed -n -e '/^## Build & Test/,/^## /{' \
		-e "/^\`\`\`${tag}$/,/^\`\`\`$/{ /^\`\`\`/d; p; }" \
		-e '}' CLAUDE.md
}

if [ -z "$CODE_FILES" ]; then
	echo ""
	echo "=== Skipping build+test (docs-only) ==="
else
	CLEAN_CMD=$(extract_block clean)
	BUILD_CMD=$(extract_block build)
	TEST_CMD=$(extract_block test)

	# Both fences are required. Running only whichever one resolved would report
	# "All checks passed" on a push that never ran the tests, and guessing a
	# build would gate a different build than the documented one.
	MISSING=""
	if [ -z "$BUILD_CMD" ]; then MISSING="${MISSING} build"; fi
	if [ -z "$TEST_CMD" ]; then MISSING="${MISSING} test"; fi
	if [ -n "$MISSING" ]; then
		echo ""
		echo "Push blocked: CLAUDE.md's '## Build & Test' section is missing a fence for:${MISSING}"
		echo "Expected blocks opened with \`\`\`build and \`\`\`test inside that section,"
		echo "and the section must still be followed by another '## ' heading."
		exit 1
	fi

	BUILD_FAILED=0

	if [ -n "$CLEAN_CMD" ]; then
		echo ""
		echo "=== Clean ==="
		set +e
		eval "$CLEAN_CMD"
		rc=$?
		set -e
		if [ "$rc" -ne 0 ]; then BUILD_FAILED=1; fi
	fi

	if [ "$BUILD_FAILED" -eq 0 ]; then
		echo ""
		echo "=== Build ==="
		set +e
		eval "$BUILD_CMD"
		rc=$?
		set -e
		if [ "$rc" -ne 0 ]; then BUILD_FAILED=1; fi
	fi

	if [ "$BUILD_FAILED" -eq 0 ]; then
		echo ""
		echo "=== Test ==="
		set +e
		eval "$TEST_CMD"
		rc=$?
		set -e
		if [ "$rc" -ne 0 ]; then BUILD_FAILED=1; fi
	fi

	if [ "$BUILD_FAILED" -ne 0 ]; then
		echo ""
		echo "Push blocked: build or tests failed."
		exit 1
	fi
fi

# ============================================================
# Step 2: Remaining issues (warn and continue)
# ============================================================

ISSUES=""

if [ -n "$CPP_FILES" ] && [ -n "$CLANG_TIDY" ] && [ -n "$COMPILE_DB" ]; then
	echo ""
	echo "=== Running clang-tidy ==="
	for f in $CPP_FILES; do
		[ -f "$f" ] || continue
		# shellcheck disable=SC2086
		RESULT=$($CLANG_TIDY $COMPILE_DB --quiet "$f" 2>&1 || true)
		if echo "$RESULT" | grep -qE '(warning|error):'; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
fi

if [ -n "$PY_FILES" ] && [ -n "$RUFF" ]; then
	for f in $PY_FILES; do
		[ -f "$f" ] || continue
		RESULT=$($RUFF check --select C901 --no-fix "$f" 2>&1 || true)
		if [ -n "$RESULT" ] && ! echo "$RESULT" | grep -q "^All checks passed"; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
fi

if [ -n "$SH_FILES" ] && [ -n "$SHELLCHECK" ]; then
	for f in $SH_FILES; do
		[ -f "$f" ] || continue
		RESULT=$($SHELLCHECK "$f" 2>&1 || true)
		if [ -n "$RESULT" ]; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
fi

if [ -n "$PY_FILES" ] && [ -n "$MYPY" ]; then
	# mypy stops at the first unreadable path, so a single deleted .py would
	# both fake a failure and mask real type errors in every surviving file.
	EXISTING_PY=""
	for f in $PY_FILES; do
		[ -f "$f" ] && EXISTING_PY="${EXISTING_PY} $f"
	done
	if [ -n "$EXISTING_PY" ]; then
		echo ""
		echo "=== Running mypy ==="
		# shellcheck disable=SC2086
		RESULT=$($MYPY --strict $EXISTING_PY 2>&1 || true)
		if echo "$RESULT" | grep -qE '(error):'; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		else
			echo "mypy: clean"
		fi
	fi
fi

if [ -n "$ISSUES" ]; then
	echo ""
	echo "═══════════════════════════════════════════"
	echo "  Issues found:"
	echo "═══════════════════════════════════════════"
	echo "$ISSUES"
	echo "═══════════════════════════════════════════"
	echo ""
	echo "Warning: pushing with known issues."
else
	echo ""
	echo "All checks passed."
fi

exit 0
